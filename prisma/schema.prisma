// ─────────────────────────────────────────────────────────────
//  WasteScheduler — Nigeria Waste Management System
//  Prisma Schema v2 — PostgreSQL
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────

enum Role {
  resident
  collector
  admin
}

enum ReportType {
  missed_pickup
  illegal_dumping
  damaged_bin
  other
}

enum ReportStatus {
  pending
  under_review
  resolved
  rejected
}

enum ScheduleStatus {
  scheduled
  completed
  missed
  cancelled
}

enum NotificationChannel {
  in_app
  email
  push
}

enum AudienceType {
  all
  residents
  collectors
  admins
}

enum BillingType {
  per_kg
  monthly_flat
  per_bin
}

enum PaymentStatus {
  pending
  paid
  overdue
  waived
}

enum QuizDifficulty {
  easy
  medium
  hard
}

// ─── MODELS ──────────────────────────────────────────────────

model User {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  passwordHash    String
  role            Role      @default(resident)
  phone           String?   @db.VarChar(20)
  address         String?   @db.VarChar(255)
  state           String?   @db.VarChar(60)
  lga             String?   @db.VarChar(100)
  avatarUrl       String?
  theme           String    @default("light") @db.VarChar(30)
  fontFamily      String    @default("Inter") @db.VarChar(60)
  fontSize        Int       @default(16)
  reminderEmails  Boolean   @default(true)
  zoneId          Int?
  isActive        Boolean   @default(true)
  emailVerified   Boolean   @default(false)
  resetToken      String?
  resetExpires    DateTime?
  googleId        String?   @unique
  points          Int       @default(0)
  badges          String[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  zone               Zone?               @relation(fields: [zoneId], references: [id])
  reports            Report[]            @relation("ReportedBy")
  assignedReports    Report[]            @relation("AssignedTo")
  notifications      Notification[]
  collectionRecords  CollectionRecord[]
  wasteLogs          WasteLog[]
  bills              Bill[]
  payments           Payment[]
  quizAttempts       QuizAttempt[]
  siteReviews        SiteReview[]
  assignmentsGiven   Assignment[]        @relation("AssignedByAdmin")
  assignmentsReceived Assignment[]       @relation("AssignedToCollector")
  assignmentMessages AssignmentMessage[] @relation("MessageSender")
  sentMessages       Message[]           @relation("SentMessages")
  receivedMessages   Message[]           @relation("ReceivedMessages")

  @@index([email])
  @@index([role])
  @@index([zoneId])
  @@map("users")
}

model Zone {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(20)
  description String?
  state       String?  @db.VarChar(60)
  lga         String?  @db.VarChar(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  pickupSchedules   PickupSchedule[]
  recyclingCenters  RecyclingCenter[]
  pricingRules      PricingRule[]

  @@index([code])
  @@map("zones")
}

model WasteCategory {
  id            Int      @id @default(autoincrement())
  name          String   @unique @db.VarChar(100)
  slug          String   @unique @db.VarChar(100)
  color         String   @db.VarChar(20)
  binColor      String   @db.VarChar(50)
  icon          String?
  description   String?
  collectionDay String?  @db.VarChar(60)
  tips          String[]
  pricePerKg    Float?   @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pickupSchedules  PickupSchedule[]
  wasteLogs        WasteLog[]
  pricingRules     PricingRule[]

  @@index([slug])
  @@map("waste_categories")
}

model PricingRule {
  id           Int         @id @default(autoincrement())
  zoneId       Int?
  categoryId   Int?
  billingType  BillingType @default(per_kg)
  pricePerKg   Float?      @default(50)
  monthlyFlat  Float?      @default(2000)
  pricePerBin  Float?      @default(500)
  currency     String      @default("NGN") @db.VarChar(10)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  zone     Zone?         @relation(fields: [zoneId], references: [id])
  category WasteCategory? @relation(fields: [categoryId], references: [id])

  @@map("pricing_rules")
}

model Bill {
  id            Int           @id @default(autoincrement())
  userId        Int
  month         Int
  year          Int
  billingType   BillingType   @default(monthly_flat)
  totalKg       Float?        @default(0)
  amountNaira   Float         @default(0)
  status        PaymentStatus @default(pending)
  dueDate       DateTime
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([month, year])
  @@map("bills")
}

model Payment {
  id              Int           @id @default(autoincrement())
  userId          Int
  billId          Int?
  amountNaira     Float
  bankName        String?       @db.VarChar(100)
  accountName     String?       @db.VarChar(100)
  accountNumber   String?       @db.VarChar(20)
  transferRef     String?       @db.VarChar(100)
  proofImageUrl   String?
  status          PaymentStatus @default(pending)
  confirmedAt     DateTime?
  confirmedBy     Int?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  bill  Bill? @relation(fields: [billId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model PickupSchedule {
  id              Int            @id @default(autoincrement())
  title           String         @db.VarChar(200)
  zoneId          Int
  categoryId      Int
  pickupDate      DateTime
  recurrence      String?        @db.VarChar(50)
  status          ScheduleStatus @default(scheduled)
  notes           String?
  collectorId     Int?
  truckId         Int?
  reminderSent    Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  zone             Zone             @relation(fields: [zoneId], references: [id])
  category         WasteCategory    @relation(fields: [categoryId], references: [id])
  truck            Truck?           @relation(fields: [truckId], references: [id])
  collectionRecord CollectionRecord?

  @@index([zoneId])
  @@index([categoryId])
  @@index([pickupDate])
  @@index([status])
  @@map("pickup_schedules")
}

model Truck {
  id           Int      @id @default(autoincrement())
  plateNumber  String   @unique @db.VarChar(20)
  model        String?  @db.VarChar(100)
  capacity     Float?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pickupSchedules   PickupSchedule[]
  collectionRecords CollectionRecord[]

  @@map("trucks")
}

model CollectionRecord {
  id            Int      @id @default(autoincrement())
  scheduleId    Int      @unique
  collectorId   Int
  truckId       Int?
  quantityKg    Float?
  notes         String?
  proofImageUrl String?
  completedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  schedule  PickupSchedule @relation(fields: [scheduleId], references: [id])
  collector User           @relation(fields: [collectorId], references: [id])
  truck     Truck?         @relation(fields: [truckId], references: [id])

  @@index([collectorId])
  @@index([completedAt])
  @@map("collection_records")
}

model WasteLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  categoryId  Int
  quantityKg  Float
  notes       String?
  loggedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id])
  category WasteCategory @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([categoryId])
  @@index([loggedAt])
  @@map("waste_logs")
}

model Report {
  id           Int          @id @default(autoincrement())
  reporterId   Int
  assignedToId Int?
  type         ReportType
  status       ReportStatus @default(pending)
  description  String
  imageUrl     String?
  latitude     Float?
  longitude    Float?
  address      String?
  adminNotes   String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reporter   User  @relation("ReportedBy", fields: [reporterId], references: [id])
  assignedTo User? @relation("AssignedTo", fields: [assignedToId], references: [id])

  @@index([reporterId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("reports")
}

model RecyclingCenter {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  address      String
  latitude     Float
  longitude    Float
  phone        String?  @db.VarChar(20)
  email        String?  @db.VarChar(255)
  website      String?
  zoneId       Int?
  state        String?  @db.VarChar(60)
  lga          String?  @db.VarChar(100)
  openingHours String?
  acceptedTypes String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  zone Zone? @relation(fields: [zoneId], references: [id])

  @@index([zoneId])
  @@index([latitude, longitude])
  @@map("recycling_centers")
}

model Notification {
  id        Int                 @id @default(autoincrement())
  userId    Int?
  title     String              @db.VarChar(255)
  message   String
  channel   NotificationChannel @default(in_app)
  reminderKey String?
  isRead    Boolean             @default(false)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, reminderKey])
  @@map("notifications")
}

model Announcement {
  id        Int          @id @default(autoincrement())
  title     String       @db.VarChar(255)
  message   String
  audience  AudienceType @default(all)
  imageUrl  String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([createdAt])
  @@map("announcements")
}

model WasteGuideItem {
  id             Int      @id @default(autoincrement())
  itemName       String   @db.VarChar(200)
  aliases        String[]
  categorySlug   String   @db.VarChar(100)
  disposalMethod String
  binColor       String   @db.VarChar(50)
  specialNotes   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([itemName])
  @@index([categorySlug])
  @@map("waste_guide_items")
}

// ─── QUIZ / GAMIFICATION ─────────────────────────────────────

model Quiz {
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(200)
  description String?
  category    String?        @db.VarChar(100)
  difficulty  QuizDifficulty @default(easy)
  timeLimit   Int            @default(30)
  points      Int            @default(10)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  questions    QuizQuestion[]
  attempts     QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id            Int      @id @default(autoincrement())
  quizId        Int
  question      String
  options       String[]
  correctAnswer Int
  explanation   String?
  points        Int      @default(5)
  createdAt     DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id          Int      @id @default(autoincrement())
  userId      Int
  quizId      Int
  score       Int      @default(0)
  totalPoints Int      @default(0)
  passed      Boolean  @default(false)
  answers     Json
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  quiz Quiz @relation(fields: [quizId], references: [id])

  @@index([userId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model Leaderboard {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  points    Int      @default(0)
  rank      Int?
  badges    String[]
  updatedAt DateTime @updatedAt

  @@index([points])
  @@map("leaderboard")
}

model SiteReview {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([rating])
  @@map("site_reviews")
}

// ─── ASSIGNMENT & MESSAGING MODELS ───────────────────────────

enum AssignmentStatus {
  pending
  accepted
  in_progress
  completed
  rejected
}

enum AssignmentPriority {
  low
  normal
  high
  urgent
}

model Assignment {
  id            Int                @id @default(autoincrement())
  title         String             @db.VarChar(255)
  description   String
  adminId       Int
  collectorId   Int
  scheduleId    Int?
  zoneId        Int?
  status        AssignmentStatus   @default(pending)
  priority      AssignmentPriority @default(normal)
  dueDate       DateTime?
  completedAt   DateTime?
  notes         String?
  proofImageUrl String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  admin     User            @relation("AssignedByAdmin", fields: [adminId], references: [id])
  collector User            @relation("AssignedToCollector", fields: [collectorId], references: [id])
  messages  AssignmentMessage[]

  @@index([adminId])
  @@index([collectorId])
  @@index([status])
  @@map("assignments")
}

model AssignmentMessage {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  senderId     Int
  message      String
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  sender     User       @relation("MessageSender", fields: [senderId], references: [id])

  @@index([assignmentId])
  @@index([senderId])
  @@map("assignment_messages")
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  subject    String?  @db.VarChar(255)
  body       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
  @@map("messages")
}
