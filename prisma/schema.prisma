// ─────────────────────────────────────────────────────────────
//  Waste Scheduler & Recycling Management System
//  Prisma Schema — PostgreSQL
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────

enum Role {
  resident
  collector
  admin
}

enum ReportType {
  missed_pickup
  illegal_dumping
  damaged_bin
  other
}

enum ReportStatus {
  pending
  under_review
  resolved
  rejected
}

enum ScheduleStatus {
  scheduled
  completed
  missed
  cancelled
}

enum NotificationChannel {
  in_app
  email
  push
}

enum AudienceType {
  all
  residents
  collectors
  admins
}

// ─── MODELS ──────────────────────────────────────────────────

model User {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  email         String   @unique @db.VarChar(255)
  passwordHash  String
  role          Role     @default(resident)
  phone         String?  @db.VarChar(20)
  address       String?  @db.VarChar(255)
  avatarUrl     String?
  zoneId        Int?
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  resetToken    String?
  resetExpires  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  zone               Zone?               @relation(fields: [zoneId], references: [id])
  reports            Report[]            @relation("ReportedBy")
  assignedReports    Report[]            @relation("AssignedTo")
  notifications      Notification[]
  collectionRecords  CollectionRecord[]
  wasteLogs          WasteLog[]

  @@index([email])
  @@index([role])
  @@index([zoneId])
  @@map("users")
}

model Zone {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  code        String   @unique @db.VarChar(20)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users             User[]
  pickupSchedules   PickupSchedule[]
  recyclingCenters  RecyclingCenter[]

  @@index([code])
  @@map("zones")
}

model WasteCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  color       String   @db.VarChar(20)
  binColor    String   @db.VarChar(50)
  icon        String?
  description String?
  collectionDay String?  @db.VarChar(60)
  tips        String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pickupSchedules  PickupSchedule[]
  wasteLogs        WasteLog[]

  @@index([slug])
  @@map("waste_categories")
}

model PickupSchedule {
  id              Int            @id @default(autoincrement())
  title           String         @db.VarChar(200)
  zoneId          Int
  categoryId      Int
  pickupDate      DateTime
  recurrence      String?        @db.VarChar(50) // daily, weekly, biweekly, monthly
  status          ScheduleStatus @default(scheduled)
  notes           String?
  collectorId     Int?
  truckId         Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  zone             Zone            @relation(fields: [zoneId], references: [id])
  category         WasteCategory   @relation(fields: [categoryId], references: [id])
  truck            Truck?          @relation(fields: [truckId], references: [id])
  collectionRecord CollectionRecord?

  @@index([zoneId])
  @@index([categoryId])
  @@index([pickupDate])
  @@index([status])
  @@map("pickup_schedules")
}

model Truck {
  id           Int      @id @default(autoincrement())
  plateNumber  String   @unique @db.VarChar(20)
  model        String?  @db.VarChar(100)
  capacity     Float?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pickupSchedules   PickupSchedule[]
  collectionRecords CollectionRecord[]

  @@map("trucks")
}

model CollectionRecord {
  id           Int      @id @default(autoincrement())
  scheduleId   Int      @unique
  collectorId  Int
  truckId      Int?
  quantityKg   Float?
  notes        String?
  proofImageUrl String?
  completedAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  schedule   PickupSchedule @relation(fields: [scheduleId], references: [id])
  collector  User           @relation(fields: [collectorId], references: [id])
  truck      Truck?         @relation(fields: [truckId], references: [id])

  @@index([collectorId])
  @@index([completedAt])
  @@map("collection_records")
}

model WasteLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  categoryId  Int
  quantityKg  Float
  notes       String?
  loggedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id])
  category WasteCategory @relation(fields: [categoryId], references: [id])

  @@index([userId])
  @@index([categoryId])
  @@index([loggedAt])
  @@map("waste_logs")
}

model Report {
  id           Int          @id @default(autoincrement())
  reporterId   Int
  assignedToId Int?
  type         ReportType
  status       ReportStatus @default(pending)
  description  String
  imageUrl     String?
  latitude     Float?
  longitude    Float?
  address      String?
  adminNotes   String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reporter   User  @relation("ReportedBy", fields: [reporterId], references: [id])
  assignedTo User? @relation("AssignedTo", fields: [assignedToId], references: [id])

  @@index([reporterId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("reports")
}

model RecyclingCenter {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200)
  address     String
  latitude    Float
  longitude   Float
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(255)
  website     String?
  zoneId      Int?
  openingHours String?
  acceptedTypes String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  zone Zone? @relation(fields: [zoneId], references: [id])

  @@index([zoneId])
  @@index([latitude, longitude])
  @@map("recycling_centers")
}

model Notification {
  id        Int                 @id @default(autoincrement())
  userId    Int?
  title     String              @db.VarChar(255)
  message   String
  channel   NotificationChannel @default(in_app)
  isRead    Boolean             @default(false)
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Announcement {
  id        Int          @id @default(autoincrement())
  title     String       @db.VarChar(255)
  message   String
  audience  AudienceType @default(all)
  imageUrl  String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([createdAt])
  @@map("announcements")
}

model WasteGuideItem {
  id            Int      @id @default(autoincrement())
  itemName      String   @db.VarChar(200)
  aliases       String[]
  categorySlug  String   @db.VarChar(100)
  disposalMethod String
  binColor      String   @db.VarChar(50)
  specialNotes  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([itemName])
  @@index([categorySlug])
  @@map("waste_guide_items")
}
